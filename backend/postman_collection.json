{
  "info": {
    "name": "Mini Trello Backend",
    "_postman_id": "mini-trello-backend",
    "description": "Collection to test backend API: auth, boards, lists, cards, recommendations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth / Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
      }
    },
    {
      "name": "Auth / Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
      }
    },
    {
      "name": "Boards / Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"My Test Board\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/boards", "host": ["{{baseUrl}}"], "path": ["api","boards"] }
      }
    },
    {
      "name": "Boards / List",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/boards", "host": ["{{baseUrl}}"], "path": ["api","boards"] }
      }
    },
    {
      "name": "Boards / Get Board",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/boards/:boardId", "host": ["{{baseUrl}}"], "path": ["api","boards",":boardId"] }
      }
    },
    {
      "name": "Lists / Add List",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"To Do\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/boards/:boardId/lists", "host": ["{{baseUrl}}"], "path": ["api","boards",":boardId","lists"] }
      }
    },
    {
      "name": "Cards / Add Card",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"My card\",\n  \"description\": \"This is a test card\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/boards/:boardId/cards", "host": ["{{baseUrl}}"], "path": ["api","boards",":boardId","cards"] }
      }
    },
    {
      "name": "Cards / Update Card",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"list\": \"In Progress\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/boards/:boardId/cards/:cardId", "host": ["{{baseUrl}}"], "path": ["api","boards",":boardId","cards",":cardId"] }
      }
    },
    {
      "name": "Recommendations / Get",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/recommendations/:boardId", "host": ["{{baseUrl}}"], "path": ["api","recommendations",":boardId"] }
      }
    },
    {
      "name": "Invite / Add Member",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"coworker@example.com\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/boards/:boardId/invite", "host": ["{{baseUrl}}"], "path": ["api","boards",":boardId","invite"] }
      }
    }
  ],
  "event": [],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" }
  ]
}
